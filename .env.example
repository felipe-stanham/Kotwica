# Local development only. Never deployed: on the Pi, Latarnia sets ENV and injects GODADDY_API_TOKEN.
# Process environment wins over this file; this file wins over the committed defaults in kotwica/config.py.
# ENV=dev

# Prefix every override with DEV_, TST_ or PROD_ to match ENV.
# DEV_GODADDY_API_TOKEN=
# DEV_DOMAIN=stanham.com
# DEV_MANAGED_RECORD=kotwica-dev
# DEV_WATCHED_HOSTS=home.stanham.com:443,home.stanham.com:8443
# DEV_TLS_CONNECT_HOST=
# DEV_RESOLVERS=8.8.8.8,1.1.1.1
# DEV_IP_ECHO_URLS=https://api.ipify.org,https://icanhazip.com
# DEV_SYNC_INTERVAL_S=300
# DEV_WATCH_INTERVAL_S=900
# DEV_LOG_LEVEL=DEBUG
